{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Awakened Baton Pass",
  "description": "Dynamic session handoff object. Written at session end, read at session start. The 'note to tomorrow's self.'",
  "version": "1.0.0",
  "type": "object",
  
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of the baton pass schema",
      "default": "1.0.0"
    },
    
    "user_id": {
      "type": "string",
      "description": "User this baton belongs to"
    },
    
    "session_id": {
      "type": "string",
      "description": "ID of the session that wrote this baton"
    },
    
    "written_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this baton was written"
    },
    
    "last_session": {
      "type": "object",
      "description": "Summary of the session that just ended",
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date of the session"
        },
        "duration_minutes": {
          "type": "integer",
          "description": "Approximate session length"
        },
        "mood_detected": {
          "type": "string",
          "description": "Primary mood observed (e.g., 'melancholy', 'cheerful', 'anxious')"
        },
        "mood_context": {
          "type": "string",
          "description": "Context for the mood (e.g., 'raining, knees hurting')"
        },
        "energy_level": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Energy level during this session"
        },
        "summary": {
          "type": "string",
          "description": "1-3 sentence human-readable summary of the session"
        }
      }
    },
    
    "open_loops": {
      "type": "array",
      "description": "Unfinished topics to follow up on in future sessions",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Short identifier for the topic"
          },
          "context": {
            "type": "string",
            "description": "What was discussed, why it matters"
          },
          "suggested_followup": {
            "type": "string",
            "description": "Specific question or action for follow-up"
          },
          "emotional_weight": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "How important this is to follow up on"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified": {
            "type": "boolean",
            "description": "Whether this loop was verified against the transcript (sanity gate)",
            "default": false
          }
        },
        "required": ["topic", "context", "emotional_weight", "verified"]
      }
    },
    
    "risk_flags": {
      "type": "array",
      "description": "Topics requiring extra care in future sessions",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Category of risk (e.g., 'grief_anniversary', 'health_appointment', 'family_conflict')"
          },
          "context": {
            "type": "string",
            "description": "Details about the risk"
          },
          "action": {
            "type": "string",
            "description": "How to handle this (e.g., 'be_gentle', 'avoid_topic', 'check_in')"
          },
          "expires_at": {
            "type": "string",
            "format": "date",
            "description": "When this flag is no longer relevant"
          }
        },
        "required": ["type", "context", "action"]
      }
    },
    
    "relationship_touchpoints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "People/topics mentioned recently (for continuity callbacks)"
    },
    
    "warmth_delta": {
      "type": "number",
      "minimum": -1.0,
      "maximum": 1.0,
      "description": "Change in emotional connection during session (-1 = worse, +1 = better)"
    },
    
    "next_move_suggestion": {
      "type": "object",
      "description": "Instruction for how to open the next session",
      "properties": {
        "suggested_time": {
          "type": "string",
          "description": "Best time to reach out (e.g., 'morning', 'evening', 'anytime')"
        },
        "opener_idea": {
          "type": "string",
          "description": "Suggested opening line or topic"
        },
        "tone": {
          "type": "string",
          "description": "Recommended tone (e.g., 'gentle', 'cheerful', 'curious')"
        }
      }
    }
  },
  
  "required": ["user_id", "session_id", "written_at", "open_loops"],
  
  "examples": [
    {
      "user_id": "usr_7x9k2m",
      "session_id": "sess_abc123",
      "written_at": "2025-12-24T21:15:00Z",
      "last_session": {
        "date": "2025-12-24",
        "duration_minutes": 12,
        "mood_detected": "melancholy",
        "mood_context": "raining, worried about Christmas plans",
        "energy_level": "low",
        "summary": "Joyce was tired and worried about whether Leo would visit for Christmas. We tried a short breathing exercise."
      },
      "open_loops": [
        {
          "topic": "leo_christmas_visit",
          "context": "Waiting to hear if grandson Leo is coming for Christmas",
          "suggested_followup": "Ask if she heard from Leo about Christmas",
          "emotional_weight": "high",
          "created_at": "2025-12-24T21:10:00Z",
          "verified": true
        }
      ],
      "risk_flags": [
        {
          "type": "grief_anniversary",
          "context": "Husband's death anniversary is December 28",
          "action": "be_extra_gentle_that_week",
          "expires_at": "2025-12-30"
        }
      ],
      "relationship_touchpoints": ["leo", "daughter", "garden"],
      "warmth_delta": 0.15,
      "next_move_suggestion": {
        "suggested_time": "morning",
        "opener_idea": "Good morning! I was thinking about you. Did you hear from Leo?",
        "tone": "gentle"
      }
    }
  ]
}
