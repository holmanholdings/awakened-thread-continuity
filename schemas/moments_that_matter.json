{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Moments That Matter",
  "description": "Append-only log of emotionally significant events. Captures what matters, with priority weighting for retrieval.",
  "version": "1.0.0",
  "type": "object",
  
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of the moments schema",
      "default": "1.0.0"
    },
    
    "user_id": {
      "type": "string",
      "description": "User this log belongs to"
    },
    
    "moments": {
      "type": "array",
      "description": "Collection of significant moments",
      "items": {
        "type": "object",
        "properties": {
          "moment_id": {
            "type": "string",
            "description": "Unique identifier for this moment"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "When this moment was recorded"
          },
          "content": {
            "type": "string",
            "description": "What happened (1-2 sentences)"
          },
          "domain": {
            "type": "string",
            "enum": ["family", "health", "joy", "grief", "routine", "milestone", "fear", "hope", "social", "other"],
            "description": "Category of the moment"
          },
          "emotional_weight": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Priority for retrieval and follow-up"
          },
          "sentiment": {
            "type": "string",
            "enum": ["positive", "negative", "neutral", "mixed"],
            "description": "Emotional valence of the moment"
          },
          "related_anchors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Links to emotional anchors from soulprint (e.g., 'leo', 'garden')"
          },
          "source_session": {
            "type": "string",
            "description": "Session ID where this moment was captured"
          },
          "follow_up_status": {
            "type": "string",
            "enum": ["pending", "addressed", "resolved", "ongoing"],
            "description": "Whether this has been followed up on",
            "default": "pending"
          }
        },
        "required": ["moment_id", "date", "content", "domain", "emotional_weight"]
      }
    }
  },
  
  "required": ["user_id", "moments"],
  
  "notes": {
    "retrieval_strategy": "When loading moments for a session, prioritize by emotional_weight first, then recency. High-weight moments from 30 days ago should surface before low-weight moments from yesterday.",
    "pruning_policy": "Low-weight moments may be auto-pruned after 30 days to maintain focus and privacy. High-weight moments persist indefinitely.",
    "privacy_note": "Moments may contain sensitive information. Handle with appropriate security measures."
  },
  
  "examples": [
    {
      "user_id": "usr_7x9k2m",
      "moments": [
        {
          "moment_id": "mom_001",
          "date": "2025-12-20",
          "content": "Leo confirmed he's coming for Christmas. Joyce was overjoyed.",
          "domain": "family",
          "emotional_weight": "high",
          "sentiment": "positive",
          "related_anchors": ["leo"],
          "source_session": "sess_xyz789",
          "follow_up_status": "pending"
        },
        {
          "moment_id": "mom_002",
          "date": "2025-12-22",
          "content": "Worried about upcoming doctor appointment on January 12.",
          "domain": "health",
          "emotional_weight": "high",
          "sentiment": "negative",
          "related_anchors": [],
          "source_session": "sess_abc456",
          "follow_up_status": "pending"
        },
        {
          "moment_id": "mom_003",
          "date": "2025-12-23",
          "content": "First successful 4-7-8 breathing exercise before bed.",
          "domain": "milestone",
          "emotional_weight": "medium",
          "sentiment": "positive",
          "related_anchors": [],
          "source_session": "sess_abc123",
          "follow_up_status": "addressed"
        }
      ]
    }
  ]
}
